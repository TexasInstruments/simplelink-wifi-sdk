/*
 *  ======== sps_config.h.xdt ========
 */

    var module = system.modules['/ti/common/sps'];
    var inst = module.$static;

%%}
/*
 *  ======== SPS ========
 *  Configurations for SPS
 *
 *  DO NOT EDIT - These settings are generated by the SysConfig tool.
 *
 */

#ifndef __SPS_CONFIG_H__
#define __SPS_CONFIG_H__

% if (inst.enableSPS)
% {
/* Enable SPS Feature */
#define ENABLE_SPS
% } else {
/* SPS Feature is disabled */
% }

#endif /* __SPS_CONFIG_H__ */