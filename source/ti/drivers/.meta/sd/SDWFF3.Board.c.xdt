/*
 *  ======== SDWFF3.Board.c.xdt ========
 */

    let Common    = system.getScript("/ti/drivers/Common.js");
    let SD        = args[0];
    let instances = SD.$instances;

    if (instances.length == 0) return;

    /* CONFIG_XXXCOUNT string, derived from defaultInstanceName */
    let countDef = SD.defaultInstanceName + "COUNT";

    /* localize the object names with this device ID */
    let devId = system.deviceData.deviceId;

    /* Get name of device specific include directory */
    let devicesDir = Common.device2DevicesDir(devId);

    let driver = 'SDWFF3';

%%}
/*
 *  =============================== SD ===============================
 */

#include <ti/drivers/SD.h>
#include <ti/drivers/sd/SDWFF3.h>
#include <ti/drivers/GPIO.h>
#include <ti/drivers/Power.h>
#include <ti/drivers/dma/DMAWFF3.h>
#include <ti/devices/`devicesDir`/inc/hw_memmap.h>
#include <ti/devices/`devicesDir`/inc/hw_ints.h>
#include <ti/devices/`devicesDir`/inc/hw_soc_aon.h>

#define `countDef` `instances.length`

`driver`_Object `driver`_object[`countDef`];

/*
 *  ======== SDWFF3_Configs ========
 */
const `driver`_HwAttrs `driver`_hwAttrs[`countDef`] = {
% for (let i = 0; i < instances.length; i++) {
%     let inst        = instances[i];
%     let dmaDevicePinName = inst.sd.dmaChannel.$solution.devicePinName;
%
%     let busSize = 4;
%     if (inst.numOfDataLines == '1 Pins') {
%         busSize = 1;
%     }
%
%     let divClock = 0;
%     if (inst.busFreq == '20MHz') {
%         divClock = 2;
%     }
%     else if (inst.busFreq == '10MHz') {
%         divClock = 4;
%     }
%
%
  {
    .baseAddr           = SDMMC_BASE,
    .intNum             = INT_EVT_SDMMC_PUB_REQ,
    .intPriority        = `Common.intPriority2Hex(inst.interruptPriority)`,
    .powerID            = PowerWFF3_PERIPH_SDMMC,
    .DmaChannel         = `dmaDevicePinName.slice(6, dmaDevicePinName.length)`,
    .clkPin             = `inst.sd.clkPin.$solution.devicePinName.replace("GPIO", "")`,
    .clkPinMux          = `inst.sd.clkPin.$solution.muxMode`,
    .cmdPin             = `inst.sd.cmdPin.$solution.devicePinName.replace("GPIO", "")`,
    .cmdPinMux          = `inst.sd.cmdPin.$solution.muxMode`,
    .data0Pin           = `inst.sd.data0Pin.$solution.devicePinName.replace("GPIO", "")`,
    .data0PinMux        = `inst.sd.data0Pin.$solution.muxMode`,
%if(inst.numOfDataLines == '4 Pins'){
    .data1Pin           = `inst.sd.data1Pin.$solution.devicePinName.replace("GPIO", "")`,
    .data1PinMux        = `inst.sd.data1Pin.$solution.muxMode`,
    .data2Pin           = `inst.sd.data2Pin.$solution.devicePinName.replace("GPIO", "")`,
    .data2PinMux        = `inst.sd.data2Pin.$solution.muxMode`,
    .data3Pin           = `inst.sd.data3Pin.$solution.devicePinName.replace("GPIO", "")`,
    .data3PinMux        = `inst.sd.data3Pin.$solution.muxMode`,
%}
%else{
    .data1Pin           = GPIO_INVALID_INDEX,
    .data1PinMux        = GPIO_MUX_GPIO_INTERNAL,
    .data2Pin           = GPIO_INVALID_INDEX,
    .data2PinMux        = GPIO_MUX_GPIO_INTERNAL,
    .data3Pin           = GPIO_INVALID_INDEX,
    .data3PinMux        = GPIO_MUX_GPIO_INTERNAL,
%}
%if(inst.CardDetect != 'Disable'){
    .cdPin              = `inst.sd.cdPin.$solution.devicePinName.replace("GPIO", "")`,
    .cdPinMux           = `inst.sd.cdPin.$solution.muxMode`,
%}
%else{
    .cdPin              = GPIO_INVALID_INDEX,
    .cdPinMux           = GPIO_MUX_GPIO_INTERNAL,
%}
%if(inst.WriteProtect != 'Disable'){
    .wpPin              = `inst.sd.wpPin.$solution.devicePinName.replace("GPIO", "")`,
    .wpPinMux           = `inst.sd.wpPin.$solution.muxMode`,
%}
%else{
    .wpPin              = GPIO_INVALID_INDEX,
    .wpPinMux           = GPIO_MUX_GPIO_INTERNAL,
%}
%if(inst.powerSignal != 'Disable'){
    .powPin             = `inst.sd.powPin.$solution.devicePinName.replace("GPIO", "")`,
    .powPinMux          = `inst.sd.powPin.$solution.muxMode`,
%}
%else{
    .powPin             = GPIO_INVALID_INDEX,
    .powPinMux          = GPIO_MUX_GPIO_INTERNAL,
%}
    .numData            = `busSize`,
    .divClk             = `divClock`,
%if(inst.CardDetect != 'Disable'){
    .cdEnable           = true,
%if(inst.CardDetect == 'Enable Active High'){
    .cdPolHigh         = true,
%}
%else{
    .cdPolHigh         = false,
%}
%}
%else{
    .cdEnable           = false,
    .cdPolHigh         = false,
%}
%if(inst.WriteProtect != 'Disable'){
    .wpEnable           = true,
%if(inst.WriteProtect == 'Enable Active High'){
    .wpPolHigh         = true,
%}
%else{
    .wpPolHigh         = false,
%}
%}
%else{
    .wpEnable           = false,
    .wpPolHigh         = false,
%}
%if(inst.powerSignal != 'Disable'){
    .powEnable          = true,
%if(inst.powerSignal == 'Enable, Turn-Off Sleep'){
    .powerOffInSleep    = true
%}
%else{
    .powerOffInSleep    = false
%}
%}
%else{
    .powEnable          = false,
    .powerOffInSleep    = false
%}
% }
},
};

const SD_Config SD_config[`countDef`] = {
% for (let i = 0; i < instances.length; i++) {
%     let inst    = instances[i];
    {   /* `inst.$name` */
        .fxnTablePtr = &`driver`_fxnTable,
        .object      = &`driver`_object[`i`],
        .hwAttrs     = &`driver`_hwAttrs[`i`]
    },
% }
};

const uint_least8_t SD_count = `countDef`;
