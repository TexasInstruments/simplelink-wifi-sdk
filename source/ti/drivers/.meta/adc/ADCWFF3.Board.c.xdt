/*
 *  ======== ADCWFF3.Board.c.xdt ========
 */

    /* passed by /ti/drivers/templates/Board.c.xdt */
    let ADC = args[0];
    let ADCWFF3Channel = system.modules["/ti/drivers/adc/ADCWFF3Channel"];
    let instances = ADC.$instances;
    if (instances.length == 0) return;

    /* Get Common /ti/drivers utility functions */
    let Common = system.getScript("/ti/drivers/Common.js");

    let declarations = Common.genBoardDeclarations(instances);

    /* CONFIG_XXXCOUNT string, derived from defaultInstanceName */
    let countDef = ADC.defaultInstanceName + "COUNT";

%%}
/*
 *  =============================== ADC ===============================
 */

#include <ti/drivers/ADC.h>
#include <ti/drivers/adc/ADCWFF3.h>
#include <ti/drivers/GPIO.h>

#define `countDef` `instances.length`

/*
 *  ======== ADCWFF3_objects ========
 */
ADCWFF3_Object ADCWFF3_objects[`countDef`];

/*
 *  ======== ADCWFF3_hwAttrs ========
 */
const ADCWFF3_HWAttrs ADCWFF3_hwAttrs[`countDef`] = {
% for (let i = 0; i < instances.length; i++) {
    % let inst = instances[i];
    % let channelInfo = ADCWFF3Channel._getChannelInfo(inst.adcChannel);
    /* `inst.$name` */
    % if (inst.$hardware) {
    %    if (inst.$hardware.displayName) {
    /* `inst.$hardware.displayName` */
    %    }
    % }
    {
        .adcInputDIO         = `channelInfo.inputPin`,
        .internalChannel     = `channelInfo.adcChannel`,
        .refSource           = `channelInfo.refSource`,
        .samplingDuration    = `inst.adcSampleTime`,
        .adcClkDivider       = `inst.adcClockDivider`,
        .sampleClkSrc        = `inst.adcSampleClockSource`,
        .fullScaleRange      = `inst.adcFullScaleRange`
    },
% }
};

/*
 *  ======== ADC_config ========
 */
const ADC_Config ADC_config[`countDef`] = {
% for (let i = 0; i < instances.length; i++) {
    % let inst = instances[i];
    /* `inst.$name` */
    % if (inst.$hardware) {
    %    if (inst.$hardware.displayName) {
    /* `inst.$hardware.displayName` */
    %    }
    % }
    {
        .fxnTablePtr    = &ADCWFF3_fxnTable,
        .object         = &ADCWFF3_objects[`inst.$name`],
        .hwAttrs        = &ADCWFF3_hwAttrs[`inst.$name`]
    },
% }
};

`declarations`
const uint_least8_t ADC_count = `countDef`;
